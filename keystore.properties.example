# Copiá este archivo como "keystore.properties" (misma carpeta) y completá con TUS datos.
# keystore.properties y el archivo .jks NO se suben al repositorio (están en .gitignore).
# Guardá una copia del .jks y de las contraseñas en un lugar seguro: si se pierden,
# no se pueden publicar actualizaciones firmadas con la misma clave.

# Ruta del keystore, relativa a esta carpeta (o absoluta)
storeFile=keystore/recordatorios-release.jks
storePassword=CAMBIAR
keyAlias=recordatorios
keyPassword=CAMBIAR
