rules_version = '2';

// Reglas de seguridad de Firestore (Actividad 4).
// Se publican en la consola: Firestore Database -> Reglas -> pegar -> Publicar.
// La AUTORIZACIÓN se decide acá, en el servidor: aunque alguien modifique la app
// o arme una petición a mano, no puede leer ni escribir datos de otra cuenta.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDuenio(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}/reminders/{reminderId}
    match /users/{uid}/reminders/{reminderId} {
      allow read, delete: if esDuenio(uid);

      // Además de ser el dueño, el documento tiene que ser válido:
      // el id del documento coincide con el id del recordatorio (ids estables, sin duplicados)
      // y se repiten las validaciones principales de la app.
      allow create, update: if esDuenio(uid)
        && request.resource.data.id == reminderId
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 4
        && request.resource.data.titulo.size() <= 60
        && request.resource.data.prioridad in ['ALTA', 'MEDIA', 'BAJA'];
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
